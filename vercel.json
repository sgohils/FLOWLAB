{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "fluid": true,
  "build": {
    "env": {
      "VERCEL_SUPPORT_LARGE_FUNCTIONS": "1"
    }
  },
  "services": {
    "backend": {
      "root": ".",
      "framework": "fastapi",
      "entrypoint": "backend.main:app",
      "functions": {
        "**/*.py": {
          "maxDuration": 300,
          "excludeFiles": "{frontend/**,backend/tests/**,backend/validation/**}"
        }
      }
    },
    "frontend": {
      "root": "frontend",
      "framework": "vite",
      "rewrites": [
        { "source": "/((?!api(?:/|$)).*)", "destination": "/index.html" }
      ]
    },
    "uploads": {
      "root": "frontend",
      "framework": "hono",
      "entrypoint": "api/blob-upload.ts",
      "devCommand": "npm run dev:uploads",
      "bindings": [
        { "type": "service", "service": "backend", "format": "url", "env": "BACKEND_URL" }
      ]
    }
  },
  "rewrites": [
    { "source": "/api/blob-upload", "destination": { "service": "uploads" } },
    { "source": "/api/(.*)", "destination": { "service": "backend" } },
    { "source": "/(.*)", "destination": { "service": "frontend" } }
  ]
}
