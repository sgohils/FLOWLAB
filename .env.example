# Vercel sets VERCEL=1; use FLOWLAB_HOSTED=1 to exercise hosted mode elsewhere.
FLOWLAB_HOSTED=1

# Managed PostgreSQL connection URL, with TLS configured by your provider.
DATABASE_URL=

# A PRIVATE Vercel Blob store. The browser upload-token handler uses this token.
BLOB_READ_WRITE_TOKEN=

# Queue publishing on Vercel uses the deployment's OIDC identity. For local
# hosted testing, link the project and use `vercel dev` with its environment.
# BACKEND_URL is injected by the service binding: never set it manually.
# Leave VITE_API_URL unset so browser requests stay on the shared origin.
